{
  "name": "legal-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,worker \"next dev\" \"tsx scripts/worker.ts\"",
    "build": "next build",
    "start": "concurrently -k -n web,worker \"next start\" \"tsx scripts/worker.ts\"",
    "worker": "tsx scripts/worker.ts",
    "lint": "eslint",
    "test": "vitest run src/lib",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "verify:gemini": "tsx scripts/verify-gemini.ts",
    "verify:ai": "tsx scripts/verify-gemini.ts"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "better-sqlite3": "^13.0.3",
    "diff": "^9.0.0",
    "groq-sdk": "^1.6.0",
    "lucide-react": "^1.55.0",
    "mammoth": "^1.13.0",
    "next": "16.4.0",
    "pdfjs-dist": "^6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "docx": "^9.9.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
